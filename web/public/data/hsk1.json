"感叹句"}},{"id":"1-汉语","w":"汉语","py":"Hànyǔ","hv":"hán ngữ","vi":"tiếng Hán, tiếng Trung","en":"Chinese (language)","ex":{"ruby":[["你","nǐ"],["会","huì"],["说","shuō"],["汉","hàn"],["语","yǔ"],["吗","ma"],["？"]],"vi":"Bạn biết nói tiếng Trung không?","en":"Can you speak Chinese?","tag":"能愿动词"}},{"id":"1-好","w":"好","py":"hǎo","hv":"hảo","vi":"tốt, hay, khỏe","en":"good, well","ex":{"ruby":[["你","nǐ"],["好","hǎo"],["！"],["你","nǐ"],["身","shēn"],["体","tǐ"],["好","hǎo"],["吗","ma"],["？"]],"vi":"Chào bạn! Bạn có khỏe không?","en":"Hello! How are you?","tag":"吗问句"}},{"id":"1-号","w":"号","py":"hào","hv":"hiệu","vi":"ngày (trong tháng); số","en":"date; number","ex":{"ruby":[["今","jīn"],["天","tiān"],["几","jǐ"],["月","yuè"],["几","jǐ"],["号","hào"],["？"]],"vi":"Hôm nay là ngày mấy tháng mấy?","en":"What's the date today?","tag":"特指问句"}},{"id":"1-喝","w":"喝","py":"hē","hv":"hát","vi":"uống","en":"to drink","ex":{"ruby":[["我","wǒ"],["想","xiǎng"],["喝","hē"],["一","yī"],["点","diǎn"],["儿","r"],["水","shuǐ"],["。"]],"vi":"Tôi muốn uống một chút nước.","en":"I'd like to drink a little water.","tag":"能愿动词"}},{"id":"1-和","w":"和","py":"hé","hv":"hòa","vi":"và, với","en":"and, with","ex":{"ruby":[["我","wǒ"],["和","hé"],["我","wǒ"],["同","tóng"],["学","xué"],["都","dōu"],["喜","xǐ"],["欢","huan"],["看","kàn"],["书","shū"],["。"]],"vi":"Tôi và bạn học của tôi đều thích đọc sách.","en":"My classmate and I both like reading.","tag":"陈述句"}},{"id":"1-很","w":"很","py":"hěn","hv":"ngận","vi":"rất","en":"very","ex":{"ruby":[["北","běi"],["京","jīng"],["的","de"],["天","tiān"],["气","qì"],["很","hěn"],["冷","lěng"],["。"]],"vi":"Thời tiết Bắc Kinh rất lạnh.","en":"The weather in Beijing is very cold.","tag":"形容词谓语"}},{"id":"1-后面","w":"后面","py":"hòumian","hv":"hậu diện","vi":"phía sau","en":"behind, back","ex":{"ruby":[["学","xué"],["校","xiào"],["后","hòu"],["面","mian"],["有","yǒu"],["一","yī"],["个","gè"],["商","shāng"],["店","diàn"],["。"]],"vi":"Phía sau trường học có một cửa hàng.","en":"There is a shop behind the school.","tag":"存现句"}},{