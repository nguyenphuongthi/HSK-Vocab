 ở đâu?","en":"Where is my book?","tag":"特指问句"}},{"id":"1-那","w":"那","py":"nà","hv":"na","vi":"kia, đó","en":"that","ex":{"ruby":[["那","nà"],["是","shì"],["谁","shéi"],["的","de"],["衣","yī"],["服","fu"],["？"]],"vi":"Kia là quần áo của ai?","en":"Whose clothes are those?","tag":"特指问句"}},{"id":"1-呢","w":"呢","py":"ne","hv":"ni","vi":"(trợ từ) thì sao; đang","en":"question/continuation particle","ex":{"ruby":[["我","wǒ"],["很","hěn"],["好","hǎo"],["，"],["你","nǐ"],["呢","ne"],["？"]],"vi":"Tôi khỏe, còn bạn?","en":"I'm fine, and you?","tag":"呢"}},{"id":"1-能","w":"能","py":"néng","hv":"năng","vi":"có thể","en":"can, be able to","ex":{"ruby":[["你","nǐ"],["明","míng"],["天","tiān"],["能","néng"],["不","bù"],["能","néng"],["来","lái"],["？"]],"vi":"Ngày mai bạn có đến được không?","en":"Can you come tomorrow or not?","tag":"正反问句"}},{"id":"1-你","w":"你","py":"nǐ","hv":"nễ","vi":"bạn, anh, chị (ngôi thứ hai)","en":"you","ex":{"ruby":[["你","nǐ"],["认","rèn"],["识","shi"],["那","nà"],["个","gè"],["人","rén"],["吗","ma"],["？"]],"vi":"Bạn có quen người kia không?","en":"Do you know that person?","tag":"吗问句"}},{"id":"1-年","w":"年","py":"nián","hv":"niên","vi":"năm","en":"year","ex":{"ruby":[["我","wǒ"],["在","zài"],["中","zhōng"],["国","guó"],["住","zhù"],["了","le"],["三","sān"],["年","nián"],["。"]],"vi":"Tôi đã sống ở Trung Quốc ba năm.","en":"I lived in China for three years.","tag":"时量动量"}},{"id":"1-女儿","w":"女儿","py":"nǚ'ér","hv":"nữ nhi","vi":"con gái","en":"daughter","ex":{"ruby":[["他","tā"],["女","nǚ"],["儿","ér"],["很","hěn"],["漂","piào"],["亮","liang"],["。"]],"vi":"Con gái anh ấy rất xinh.","en":"His daughter is very pretty.","tag":"形容词谓语"}},{"id":"1-朋友","w":"朋友","py":"péngyou","hv":"bằng hữu","vi":"bạn, bạn bè","en":"friend","ex":{"ruby":[["这","zhè"],["是","shì"],["我","wǒ"],["的","de"],["中","zhōng"],["国","guó"],["朋","péng"],["友","you"],["。"]],"vi":"Đây là bạn Trung Quốc của tôi.","en":"This is my Chinese friend.","tag":"是字句"}},{"id":"1-漂亮","w":"漂亮","py":"piàoliang","hv":"phiêu lượng","vi":"đẹp, xinh","en":"pre